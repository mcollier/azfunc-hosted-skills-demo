{
  "name": "func-hosted-skills",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest",
      "extensions": ["github/gh-aw"]
    },
    "ghcr.io/stuartleeks/dev-container-features/github-copilot-cli:0": {},
    "ghcr.io/azure/azure-dev/azd:latest": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    "ghcr.io/jlaundry/devcontainer-features/azure-functions-core-tools:1": {
      "version": "4.13.0"
    }
  },
  "containerEnv": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "azurite.azurite@3.35.0",
        "bierner.github-markdown-preview",
        "codezombiech.gitignore",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "humao.rest-client",
        "ms-python.black-formatter",
        "ms-python.python",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/src/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.terminal.activateEnvInCurrentTerminal": true,
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "hybrid",
        "remote.otherPortsAttributes": {
          "onAutoForward": "silent"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
